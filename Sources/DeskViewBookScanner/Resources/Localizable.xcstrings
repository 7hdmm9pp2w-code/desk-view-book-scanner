    "Bilder oder PDF-Scans wählen; die Seiten werden in dieser Reihenfolge angehängt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose images or PDF scans; pages are appended in this order."
          }
        }
      }
    },
    "Das Fenster ist nicht bereit für den iPhone-Scan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window is not ready for the iPhone scan."
          }
        }
      }
    },
    "Das Tastenkürzel konnte nicht registriert werden, vermutlich belegt es eine andere App.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcut could not be registered; another app probably uses it."
          }
        }
      }
