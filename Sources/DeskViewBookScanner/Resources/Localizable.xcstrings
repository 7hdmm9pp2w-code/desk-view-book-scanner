            "state": "translated",
            "value": "Files"
          }
        }
      }
    },
    "Der Dokumentenscanner des iPhones liefert die Seiten, ausgelöst vom Mac. Quelle oben wechseln für Dateien oder Desk View.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone's document scanner delivers the pages, triggered from the Mac. Switch the source above for files or Desk View."
          }
        }
      }
    },
    "Desk View Book Scanner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desk View Book Scanner"
          }
        }
      }
    },
    "Die Seitenbilder (%@) wandern in den Papierkorb von macOS. Text und Exporte bleiben; Markdown, Word und EPUB gehen weiter, PDF nicht mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page images (%@) move to the macOS Trash. Text and exports stay; Markdown, Word and EPUB still work, PDF does not."
          }
        }
      }
    },
    "Dokumente mit dem iPhone scannen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Documents with iPhone"
          }
        }
      }
    },
    "Dokumentenscanner auf dem iPhone, vom Mac ausgelöst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document scanner on the iPhone, triggered from the Mac."
